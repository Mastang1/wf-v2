# Assumption: STM32F407ZGT6, 1MiB internal flash, 8MHz crystal, 3.3V.
# Learning profile: two 256KiB slots, one 128KiB scratch. Not hardware-tested.
ARCH=ARM
TARGET=stm32f4
SIGN=ED25519
HASH=SHA256
VTOR=1
SPMATH=1
DEBUG=1
DEBUG_UART=0
IMAGE_HEADER_SIZE=256
WOLFBOOT_PARTITION_SIZE=0x40000
WOLFBOOT_SECTOR_SIZE=0x20000
WOLFBOOT_PARTITION_BOOT_ADDRESS=0x08020000
WOLFBOOT_PARTITION_UPDATE_ADDRESS=0x08060000
WOLFBOOT_PARTITION_SWAP_ADDRESS=0x080A0000
CLOCK_SPEED=168000000
STM32_PLLM=8
STM32_PLLN=336
STM32_PLLP=2
STM32_PLLQ=7
WOLFBOOT_RESTORE_CLOCK=1
CFLAGS_EXTRA=-DUSE_UART1
